        "issue_description": {"type": "text", "label": "问题描述"},
        "technician": {"type": "string", "label": "售后技术人员"},
        "solution": {"type": "text", "label": "解决方案"},
        "customer_satisfaction": {"type": "text", "label": "客户满意度"},
        "lessons_learned": {"type": "text", "label": "经验总结"},
        "remarks": {"type": "text", "label": "备注"},
        "status": {"type": "select", "label": "状态", "options": ["Open", "In Progress", "Resolved", "Closed"]}
      }
