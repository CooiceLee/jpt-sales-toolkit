# JPT Sales Toolkit v0.6 LAN test-server environment
#
# Copy this file to deploy/test-server.env and adjust paths/URL before launch.

# Use a test data directory that is isolated from the development database.
JPT_DATA_DIR=/path/to/jpt-sales-toolkit/data-test-server

# Bind to all LAN interfaces so other computers on the same network can access it.
JPT_TEST_HOST=0.0.0.0
JPT_TEST_PORT=8000

# Replace this with the server computer's LAN IP before sending the entry sheet.
JPT_PUBLIC_URL=http://<LAN-IP>:8000

# Reference rollback point for the current local validated baseline.
JPT_ROLLBACK_BACKUP=/path/to/jpt-sales-toolkit/data/backups/rollback_v0.6_crud_baseline_20260504_023955.zip
